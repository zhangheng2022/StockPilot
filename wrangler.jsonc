{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-pilot",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TEAM_DOMAIN": "https://zhangheng.cloudflareaccess.com",
    "POLICY_AUD": "5a8ffe5954abcea53d9114962099b8ee7e9f3e59de3b687918b3d764b0fb615b"
  },
  "main": "worker/src/index.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock_pilot",
      "database_id": "24e7c265-6391-4623-9d79-adad87aa1e12",
      "migrations_dir": "worker/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
